# database (Neon live: postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require, direct connection, pooling off)
DATABASE_URL=postgresql+psycopg://answerwatch:answerwatch@localhost:5433/answerwatch

# AI (free tiers)
GEMINI_API_KEY=
GEMINI_PROBE_MODEL=gemini-3.8-flash
GEMINI_INTERNAL_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GROQ_API_KEY=
GROQ_PROBE_MODEL=openai/gpt-oss-120b
GROQ_INTERNAL_MODEL=openai/gpt-oss-120b
GROQ_TOKENS_PER_MINUTE=8000
GROQ_MAX_OUTPUT_TOKENS=800
OPENROUTER_API_KEY=
OPENROUTER_MEMORY_MODEL=nvidia/nemotron-3.5-super-vl:free

# limits
GEMINI_MAX_CONCURRENCY=2
GROQ_MAX_CONCURRENCY=1
GROQ_DAILY_STOP_SECONDS=900          # a 429 wait longer than this (or a used-up daily quota) stops Groq for the run
GEMINI_DAILY_STOP_SECONDS=900
PAGE_CACHE_DAYS=7

# fetching
FETCH_USER_AGENT=AnswerWatchBot/0.1 (+your-email)
WIKIPEDIA_CONTACT=                    # your email or a URL: Wikimedia requires a contact in the User-Agent

# email (Gmail with 2-step verification and an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=AnswerWatch

# app
ADMIN_PASSWORD=change-me
FRONTEND_ORIGIN=http://localhost:5173   # several origins: comma separated (live: your Vercel URL)
DASHBOARD_URL=http://localhost:5173
TIMEZONE=Europe/Helsinki

# jobs: local (dev) or github (live)
JOB_RUNNER=local
GITHUB_REPO=your-user/answerwatch
GITHUB_REF=main
GITHUB_DISPATCH_TOKEN=          # fine-grained token with Actions: read and write on this repo
